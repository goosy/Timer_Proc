FUNCTION_BLOCK "Timer_Proc"
TITLE='Timer (1 s period)'
VERSION:'1.0'
KNOW_HOW_PROTECT
AUTHOR:Goosy
NAME:TimerPrc
FAMILY:GooLib

VAR_INPUT
  enable {S7_m_c := 'true'} : BOOL ; // enable counting
  reset {S7_m_c := 'true'} : BOOL ;  // reset the time to zero
  PPS : BOOL ; // pulse per second: the CPU 1 Hz clock memory bit or a GPS PPS signal
END_VAR

VAR_IN_OUT
  count {S7_m_c := 'true'} : DINT;  // total seconds
  hours {S7_m_c := 'true'} : DINT;  // hours
  minutes {S7_m_c := 'true'} : INT; // minutes
  seconds {S7_m_c := 'true'} : INT; // seconds
END_VAR

VAR
  PPS_Follower : BOOL;   // PPS follower for edge detection
  count_follower : DINT; // total seconds follower
END_VAR

VAR_TEMP
  count_change : BOOL;
  count_sum : DINT;   // computed total seconds
  minutes_sum : DINT; // computed total minutes
END_VAR

BEGIN

IF reset THEN // reset the timer
  reset := FALSE; // auto-clear so a single HMI write resets once
  count := 0;
  count_follower := 0;
  seconds := 0;
  minutes := 0;
  hours := 0;
  RETURN;
END_IF;

count_change := count <> count_follower;
IF NOT count_change THEN // total seconds not changed externally
  count_sum := hours * 3600 + minutes * 60 + seconds;
  IF count_sum <> count THEN // hours/minutes/seconds changed: apply them
    count := count_sum;
  ELSIF enable AND PPS AND NOT PPS_Follower THEN // otherwise count running time
    count := count + 1;
    count_change := TRUE;
  END_IF;
END_IF;

IF count_change THEN // total seconds changed
  seconds := DInt_to_Int(count MOD 60);
  minutes_sum := (count - seconds) DIV 60;
  minutes := DInt_to_Int(minutes_sum MOD 60);
  hours := (minutes_sum - minutes) DIV 60;
END_IF;

count_follower := count;
PPS_Follower := PPS;

END_FUNCTION_BLOCK
